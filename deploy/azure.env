# deploy/azure.env — shared settings for the Azure scripts.
#
# Every value can be overridden by exporting it before running a script, e.g.
#   LOCATION=westeurope DOCKER_USER=me ./deploy/azure-setup.sh

: "${RESOURCE_GROUP:=go-search-rg}"
: "${LOCATION:=centralindia}"          # pick a region close to your users

# Storage account names are GLOBAL across Azure: 3-24 lowercase letters/digits.
: "${STORAGE_ACCOUNT:=gosearchstorage}"
: "${SHARE_NAME:=go-search-data}"
: "${SHARE_QUOTA_GB:=5}"

: "${CONTAINER_APP_ENV:=go-search-env}"
: "${CONTAINER_APP_NAME:=go-search}"
: "${ENV_STORAGE_NAME:=gosearchfiles}"  # name of the share inside the environment

# Image: docker.io/<DOCKER_USER>/<IMAGE_REPO>:<unique tag>
: "${IMAGE_REPO:=gosearch}"

# Must match the user in the Dockerfile; the file share is mounted as this user.
: "${APP_UID:=10001}"
